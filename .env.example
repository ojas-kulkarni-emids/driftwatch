# Azure OpenAI (Strands hackathon requires the Strands SDK, not a specific
# model vendor -- Strands is provider-agnostic, so Azure is fine)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=https://<your-resource>.openai.azure.com/
AZURE_DEPLOYMENT_NAME=<your-deployment-name>
AZURE_API_VERSION=2024-08-01-preview

# GitHub PAT -- required. Unauthenticated requests are capped at 60/hour
# PER IP and shared with everyone on the same network -- confirmed exhausted
# during verification. Generate a classic token with no scopes (public read
# is enough) at https://github.com/settings/tokens
GITHUB_TOKEN=
